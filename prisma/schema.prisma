// Constructora Management System - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============
enum UserRole {
  ADMIN
  MANAGER
  WORKER
  BODEGA
  VEHICULO
  RECEPTOR
}

enum ToolStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum VehicleType {
  TRUCK
  MACHINE
  VAN
  CAR
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
}

enum ShipmentStatus {
  PENDING
  VERIFIED
  IN_TRANSIT
  RECEIVED
  DISCREPANCY
}

enum PettyCashType {
  INCOME
  EXPENSE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InvoiceType {
  ISSUED
  RECEIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum AccessStatus {
  SUCCESS
  DENIED
}

// ============ AUTENTICACIÓN ============
model User {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  role      UserRole @default(WORKER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  toolLoans      ToolLoan[]
  vehicleTrips   VehicleTrip[]
  shipments      Shipment[]
  payrollEntries PayrollEntry[]
  locationLogs   LocationLog[]
  pettyCash      PettyCash[]
  invoices       Invoice[]
  accessLogs     AccessLog[]

  @@index([code])
  @@index([role])
  @@index([isActive])
}

// ============ TRABAJADORES ============
model Worker {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  dpi             String?   @unique
  photo           String?
  birthDate       DateTime?
  phone           String?
  address         String?
  position        String?
  hourlyRate      Decimal   @db.Decimal(10,2)
  isActive        Boolean   @default(true)
  hikvisionId     String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  toolLoans       ToolLoan[]
  shipments       Shipment[]
  vehicleTrips    VehicleTrip[]
  projectStaff    ProjectStaff[]
  payrollEntries  PayrollEntry[]
  accessLogs      AccessLog[]

  @@index([dpi])
  @@index([hikvisionId])
  @@index([isActive])
}

// ============ HERRAMIENTAS ============
model Tool {
  id          String     @id @default(cuid())
  name        String
  description String?
  barcode     String?    @unique
  photo       String?
  category    String?
  status      ToolStatus @default(AVAILABLE)
  location    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  loans       ToolLoan[]

  @@index([barcode])
  @@index([status])
  @@index([category])
}

// ============ PRÉSTAMO DE HERRAMIENTAS ============
model ToolLoan {
  id         String    @id @default(cuid())
  toolId     String
  userId     String
  workerId   String?
  loanDate   DateTime  @default(now())
  returnDate DateTime?
  notes      String?
  photo      String?
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker     Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([toolId])
  @@index([userId])
  @@index([workerId])
  @@index([loanDate])
}

// ============ VEHÍCULOS ============
model Vehicle {
  id          String        @id @default(cuid())
  name        String
  plate       String        @unique
  type        VehicleType
  brand       String?
  model       String?
  year        Int?
  color       String?
  photo       String?
  status      VehicleStatus @default(AVAILABLE)
  mileage     Decimal?      @db.Decimal(12,2)
  fuelType    FuelType?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trips       VehicleTrip[]
  spareParts  VehicleSparePart[]
  shipments   Shipment[]

  @@index([plate])
  @@index([type])
  @@index([status])
}

// ============ REFACCIONES ============
model VehicleSparePart {
  id          String   @id @default(cuid())
  vehicleId   String
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10,2)
  purchaseDate DateTime?
  invoicePhoto String?
  supplier    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ============ VIAJES ============
model VehicleTrip {
  id          String    @id @default(cuid())
  vehicleId   String
  driverId    String?
  userId      String
  startDate   DateTime
  endDate     DateTime?
  origin      String?
  destination String?
  distance    Decimal?   @db.Decimal(10,2)
  purpose     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver      Worker?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([driverId])
  @@index([userId])
  @@index([startDate])
}

// ============ ENVÍOS ============
model Shipment {
  id              String         @id @default(cuid())
  vehicleId       String
  driverId        String?
  receiverId      String?
  projectId       String?
  userId          String
  shipmentDate    DateTime       @default(now())

  materialName    String?
  sentQuantity    Decimal?       @db.Decimal(12,3)
  receivedQuantity Decimal?      @db.Decimal(12,3)
  receivedDate    DateTime?

  departurePhoto  String?
  departureTime   DateTime?
  arrivalPhoto    String?
  arrivalTime     DateTime?
  receivedNotes   String?

  status          ShipmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           ShipmentItem[]
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver          Worker?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([driverId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([shipmentDate])
}

model ShipmentItem {
  id               String   @id @default(cuid())
  shipmentId       String
  materialName     String
  sentQuantity     Decimal  @db.Decimal(12,3)
  unit             String   @default("unidad")
  receivedQuantity Decimal? @db.Decimal(12,3)
  receivedNotes    String?

  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ============ CAJA CHICA ============
model PettyCash {
  id          String        @id @default(cuid())
  type        PettyCashType
  amount      Decimal       @db.Decimal(16,2)
  category    String?
  description String
  date        DateTime      @default(now())
  userId      String
  projectId   String?
  receipt     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([date])
}

// ============ PROYECTOS ============
model Project {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  description String?
  address     String?
  startDate   DateTime
  endDate     DateTime?
  status      ProjectStatus @default(PLANNING)
  budget      Float?
  progress    Float         @default(0)
  client      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  staff       ProjectStaff[]
  shipments   Shipment[]
  expenses    ProjectExpense[]
  pettyCash   PettyCash[]
  payroll     PayrollEntry[]
  invoices    Invoice[]

  @@index([code])
  @@index([status])
  @@index([client])
}

model ProjectStaff {
  id        String   @id @default(cuid())
  projectId String
  workerId  String
  role      String?
  startDate DateTime
  endDate   DateTime?
  salary    Decimal? @db.Decimal(12,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workerId])
}

model ProjectExpense {
  id        String   @id @default(cuid())
  projectId String
  category  String
  amount    Decimal  @db.Decimal(16,2)
  description String
  date      DateTime @default(now())
  receipt   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([date])
}

// ============ NÓMINA ============
model PayrollEntry {
  id        String   @id @default(cuid())
  projectId String?
  workerId  String
  userId    String
  period    String
  hours     Decimal? @db.Decimal(8,2)
  overtime  Decimal? @db.Decimal(8,2)
  salary    Decimal  @db.Decimal(12,2)
  bonuses   Decimal  @default(0) @db.Decimal(12,2)
  deductions Decimal @default(0) @db.Decimal(12,2)
  total     Decimal  @db.Decimal(12,2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workerId])
  @@index([userId])
  @@index([period])
}

// ============ UBICACIÓN EN TIEMPO REAL ============
model LocationLog {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String?
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([timestamp])
}

// ============ MÓDULO DE FACTURAS (FEL SAT GO Guatemala) ============
model Company {
  id        String   @id @default(cuid())
  nit       String   @unique
  name      String
  address   String?
  email     String?
  phone     String?

  felAlias  String?
  felToken  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices  Invoice[]

  @@index([nit])
  @@index([isActive])
}

model Client {
  id        String   @id @default(cuid())
  nit       String   @unique
  name      String
  address   String?
  email     String?
  phone     String?

  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nit])
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceType  InvoiceType   @default(ISSUED)
  companyId    String?
  clientId     String
  userId       String
  projectId    String?

  date         DateTime      @default(now())

  numero       String?
  serie        String?
  cae          String?
  certDate     DateTime?

  currency     String        @default("GTQ")
  subTotal     Decimal       @db.Decimal(16,2)
  tax          Decimal       @db.Decimal(16,2)
  total        Decimal       @db.Decimal(16,2)

  status       InvoiceStatus @default(DRAFT)

  xmlUrl       String?
  pdfUrl       String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]

  @@index([companyId])
  @@index([clientId])
  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([numero])
  @@index([cae])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12,3)
  unitPrice   Decimal @db.Decimal(12,4)
  total       Decimal @db.Decimal(16,2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============ CONTROL DE ACCESO (HIKVISION) ============
model Terminal {
  id              String    @id @default(cuid())
  name            String
  ip              String
  port            Int       @default(80)
  username        String    @default("admin")
  password        String
  serialNumber    String?   @unique
  model           String?
  lastSeen        DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accessLogs      AccessLog[]

  @@index([ip])
  @@index([isActive])
}

model AccessLog {
  id          String       @id @default(cuid())
  terminalId String?
  workerId    String?
  userId      String?
  doorName    String?
  status      AccessStatus @default(SUCCESS)
  timestamp   DateTime     @default(now())

  terminal    Terminal?    @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  worker      Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([terminalId])
  @@index([workerId])
  @@index([userId])
  @@index([timestamp])
  @@index([status])
}